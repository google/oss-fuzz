# NSM (NVIDIA System Management) protocol dictionary
# PCI Vendor ID (0x10DE big-endian) + Request/Response/Event + OCP V1/V2
"\x10\xde\x00\x89"
"\x10\xde\x00\x8a"
"\x10\xde\x40\x89"
"\x10\xde\x40\x8a"
"\x10\xde\x80\x89"
"\x10\xde\x80\x8a"
"\x10\xde\xc0\x89"
"\x10\xde\xc0\x8a"
"\x10\xde"
# Error injection types and subtypes (little-endian uint16)
"\x04\x00\x00\x00"
"\x04\x00\x01\x00"
"\x04\x00\x02\x00"
"\x04\x00\x03\x00"
"\x05\x00\x00\x00"
# FPGA MMIO IBC2 profile magic and LP30 platform string
"IBC2"
"LP30"
"\xde\xc0\xad\xde"
