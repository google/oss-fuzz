FROM gcr.io/oss-fuzz-base/base-builder

# Real CUDA headers (cuda.h, nvml.h) for the fuzzed TU. Same NVIDIA repo
# setup as projects/nccl; only header packages, no driver library.
RUN mkdir $SRC/cuda-install && \
    cd $SRC/cuda-install && \
    wget https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2004/x86_64/cuda-ubuntu2004.pin && \
    mv cuda-ubuntu2004.pin /etc/apt/preferences.d/cuda-repository-pin-600 && \
    wget https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2004/x86_64/cuda-keyring_1.1-1_all.deb && \
    dpkg -i cuda-keyring_1.1-1_all.deb && \
    apt-get update && \
    apt-get -y install cuda-cudart-dev-12-9 cuda-nvml-dev-12-9

RUN git clone --depth 1 https://github.com/Project-HAMi/HAMi-core.git $SRC/hami-core

# Fuzz targets and the static_config.h stub (normally generated by cmake)
# live here, in the oss-fuzz tree, until upstream grows its own fuzz/ dir.
COPY fuzz/ $SRC/hami-core-fuzz/
COPY build.sh $SRC/
WORKDIR $SRC/hami-core
