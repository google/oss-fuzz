# libFuzzer dictionary for the SPR2 wire format (spore/internal/ratchetwire).
# Tokens are mutation hints only; the parsers define the authoritative format.
#
# Frame header: magic "SPR2", version byte, kind byte, then fields.
magic="SPR2"
version_v1="\x01"
kind_init="\x01"
kind_message="\x02"
kind_zero="\x00"
kind_ff="\xff"

# 64-bit deadline values worth steering toward.
deadline_zero="\x00\x00\x00\x00\x00\x00\x00\x00"
deadline_max="\xff\xff\xff\xff\xff\xff\xff\xff"

# 32-bit length/counter values (message numbers, frame lengths).
len_zero="\x00\x00\x00\x00"
len_one="\x01\x00\x00\x00"
len_max32="\xff\xff\xff\xff"

# Session ids and key material are 8/24/32-byte fields; bias toward extremes.
bytes8_zero="\x00\x00\x00\x00\x00\x00\x00\x00"
bytes8_ff="\xff\xff\xff\xff\xff\xff\xff\xff"
bytes24_ff="\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff"
bytes32_zero="\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
bytes32_ff="\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff"

# Handshake degraded-mode marker: OPKID sentinel 0xFFFFFFFF.
opkid_none="\xff\xff\xff\xff"
opkid_zero="\x00\x00\x00\x00"
