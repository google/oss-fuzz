# Tokens for ares_config_files_fuzzer (resolv.conf + hosts file + names)
nameserver="\x09nameserver "
search="\x06search "
domain_kw="\x06domain "
sortlist="\x08sortlist="
options_kw="\x07options "
ndots="\x06ndots:"
timeout_opt="\x08timeout:"
attempts="\x09attempts:"
rotate="\x06rotate"
use_vc="\x06use-vc"
localhost="\x09localhost"
ip_127="127.0.0.1"
ip_10="10.1.2.3"
ip_192="192.168.1.1"
ipv6_lo="::1"
cidr="10.0.0.0/255.0.0.0"
name_host="\x02myhost"
