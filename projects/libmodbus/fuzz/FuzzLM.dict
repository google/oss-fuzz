# Function codes (modbus.h MODBUS_FC_*)
fc_read_coils="\x01"
fc_read_discrete="\x02"
fc_read_holding="\x03"
fc_read_input="\x04"
fc_write_coil="\x05"
fc_write_reg="\x06"
fc_exc_status="\x07"
fc_write_coils="\x0f"
fc_write_regs="\x10"
fc_slave_id="\x11"
fc_mask_write="\x16"
fc_write_read="\x17"
fc_exc_read_coils="\x81"
fc_exc_read_hold="\x83"
fc_exc_write_read="\x97"
# special values
coil_on="\xff\x00"
coil_off="\x00\x00"
ffff="\xff\xff"
tcp_proto_hdr="\x00\x00\x00\x06\x01"
tcp_proto_hdr_long="\x00\x01\x00\x00\x00\xff\x01"
# limits (MODBUS_MAX_*)
max_read_bits="\x07\xd0"
max_write_bits="\x07\xb0"
max_read_regs="\x00\x7d"
max_write_regs="\x00\x7b"
max_wr_write="\x00\x79"
# sizes near ADU limits
adu_rtu="\x00\xfd"
broadcast_rtu="\x00\x03"
# geometry/option bytes for the harness header
mode_reply_tcp="\x00"
mode_reply_rtu="\x01"
mode_server_tcp="\x02"
mode_server_rtu="\x03"
mode_client_tcp="\x04"
mode_client_rtu="\x05"
mode_ctor="\x06"
# strings used by constructors
host_local="localhost"
host_v6="::1"
dev="/dev/ttyS0"
svc="502"
