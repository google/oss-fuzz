# PEM boundaries and headers PEMParser recognises
"-----BEGIN "
"-----END "
"-----"
"CERTIFICATE"
"X509 CRL"
"CERTIFICATE REQUEST"
"NEW CERTIFICATE REQUEST"
"PRIVATE KEY"
"ENCRYPTED PRIVATE KEY"
"PUBLIC KEY"
"RSA PRIVATE KEY"
"RSA PUBLIC KEY"
"DSA PRIVATE KEY"
"EC PRIVATE KEY"
"EC PARAMETERS"
"PKCS7"
"CMS"
"ATTRIBUTE CERTIFICATE"
"Proc-Type: 4,ENCRYPTED"
"DEK-Info: "
"AES-128-CBC,"
"DES-EDE3-CBC,"
"\x0a"
