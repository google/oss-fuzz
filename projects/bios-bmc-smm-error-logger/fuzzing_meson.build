fuzz_engine_link_args = get_option('fuzzing_engine').split()

executable(
    'rde_fuzz',
    ['rde_fuzz.cpp', '../src/main.cpp'],
    conf_h,
    include_directories: [root_inc, bios_bmc_smm_error_logger_inc],
    implicit_include_directories: false,
    dependencies: [rde_dep, bios_bmc_smm_error_logger_dep],
    cpp_args: ['-DBIOS_BMC_FUZZING'],
    link_args: fuzz_engine_link_args,
    install: true,
)
