# Magic numbers and markers for the file formats taglib parses.

# ID3v2 / ID3v1
"ID3"
"TAG"
"APETAGEX"

# MPEG audio frame sync
"\xFF\xFB"
"\xFF\xFA"
"\xFF\xF3"
"\xFF\xF2"

# Ogg (Vorbis, Opus, Speex, FLAC-in-Ogg)
"OggS"
"\x01vorbis"
"OpusTags"
"\x80Speex"

# FLAC
"fLaC"

# MP4 / M4A / iTunes
"ftyp"
"M4A "
"mp42"
"isom"
"moov"
"udta"
"meta"
"ilst"
"covr"
"free"

# RIFF / WAV
"RIFF"
"WAVE"
"fmt "
"data"
"LIST"
"ID3 "

# AIFF
"FORM"
"AIFF"
"AIFC"
"COMM"
"SSND"

# APE / MPC / WavPack
"MAC "
"MP+"
"wvpk"

# DSF / DSDIFF
"DSD "
"FRM8"
"DSd "
"DSD"

# Matroska / WebM (EBML)
"\x1A\x45\xDF\xA3"
"matroska"
"webm"
"Segment"
"Tags"

# Tracker modules (IT, XM, S3M, MOD)
"IMPM"
"Extended Module"
"SCRM"
"M.K."
"M!K!"
"FLT4"
"4CHN"
"6CHN"

# TrueAudio
"TTA1"

# Shorten (ajkg magic)
"ajkg"
